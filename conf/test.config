/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run longHERV_validation.nf -profile test,<docker/singularity> --outdir <OUTDIR>
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

executor.name = 'local'

params {
    te_ref = "${projectDir}/tests/data/TEsequences_SVA_HERV_ALU_L1.fasta"
    ref_fasta = "${projectDir}/tests/data/sTELLeR_supplementary/refgenome/HG38_chr22.fa"
    samplefile = "${projectDir}/tests/data/samples_test.txt"
    outdir = 'results_test'
}

process {
            errorStrategy = 'terminate'
            maxRetries = 0
            time = '10.min'

            withName: STELLER {
                cpus = 1
                memory = '4 GB'
            }

            withName: TLDR {
                cpus = 1
                memory = '4 GB'
            }

            withName: TELR {
                cpus    = 1
                memory  = '4 GB'
            }

            withName: PALMER {
                cpus = 2
                memory = '4 GB'
            }

            withName: XTEA {
                cpus = 2
                memory = '4 GB'
            }

            withName: TREMOLO {
                containerOptions = '-B /scratch/prj/ppn_als_longread/HERV_detection/resources/TrEMOLO:/TrEMOLO'
                cpus = 4
                memory = '8 GB'
            }

            withName: BAM2FASTQ {
                cpus = 2
                memory = '8 GB'
            }

            withName: PREP_TREMOLO {
                cpus = 1
                memory = '1 GB'
            }

            withName: LOCATE {
                containerOptions = '-B /scratch/prj/ppn_als_longread/HERV_detection/resources/LOCATE/GRCh38:/GRCh38'
                cpus = 2
                memory = '4 GB'
            }
}
