//Parameters
params {
    // Accessory files
    ref_fasta = '/scratch/prj/ppn_als_longread/HERV_detection/resources/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna'
    te_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_SVA_HERV_ALU_L1.fasta'
    
    // Directories
    outdir = '/scratch/prj/ppn_als_longread/HERV_detection/longHERV_validation/nextflow_test/'
}

profiles {
    test {
        process.memory  = '4 GB'
        process.cpus    = 2
        process.time    = 5.min
        params.ref_fasta = '/scratch/prj/ppn_als_longread/HERV_detection/longHERV_validation/test_data/sTELLeR_supplementary/refgenome/HG38_chr22.fa'
        params.samplefile = 'samples_test.txt'
    }
}

docker.enabled = false

singularity{
    enabled = true
    autoMounts = true
    cacheDir = '/scratch/prj/ppn_als_longread/HERV_detection/singularity_cache/'
}

conda {
    enabled = true
}

executor {
    name = "slurm"
    queueSize = 50
}

process {
    queue = "cpu,nd_bioinformatics_cpu"
    errorStrategy = 'retry'
    maxRetries = 3
    time = { 1.h * task.attempt }

    withName: STELLER {
        container = 'docker://kristinebilgrav/steller'
        cpus = 2
        memory = '4 GB'
        time = { 15.min * task.attempt }
    }

    withName: TLDR {
        container = 'docker://quay.io/sarahbeecroft9/tldr'
        cpus = 10
        memory = '20 GB'
        time = { 4.h * task.attempt}
    }

    withName: PALMER {
        container = 'docker://quay.io/ymostovoy/lr-palmer'
        cpus = 2
        memory = '60 GB'
        time = { 48.h }
    }

    withName: XTEA {
        container 'docker://quay.io/ymostovoy/lr-xtea'
        cpus = 2
        memory = '64 GB'
        time = { 24.h * task.attempt}
    }
}