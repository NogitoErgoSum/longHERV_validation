//Parameters
params {
    // Accessory files
    ref_fasta = '/scratch/prj/ppn_als_longread/HERV_detection/resources/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna'
    te_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_SVA_HERV_ALU_L1.fasta'
    l1_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_L1.fasta'
    herv_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_HERV.fasta'
    sva_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_SVA.fasta'
    alu_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_ALU.fasta'
    tremolo_snk = "/scratch/prj/ppn_als_longread/HERV_detection/resources/TrEMOLO/TrEMOLO/run.snk"
    tremolo_config = "/scratch/prj/ppn_als_longread/HERV_detection/resources/TrEMOLO/TrEMOLO/config.yaml"
    
    // Directories
    outdir = '/scratch/prj/ppn_als_longread/HERV_detection/longHERV_validation/output/'
}

profiles {
    test {
        params.ref_fasta = '/scratch/prj/ppn_als_longread/HERV_detection/longHERV_validation/test_data/sTELLeR_supplementary/refgenome/HG38_chr22.fa'
        params.samplefile = 'samples_test.txt'
        time = 10.min
        
        report {
            enabled = true
            overwrite = true
        }
        trace {
            enabled = true
        }

        process {
            queue = "cpu"
            errorStrategy = 'exit'
            maxRetries = 0

            withName: STELLER {
                container = 'docker://kristinebilgrav/steller'
                cpus = 1
                memory = '4 GB'
            }

            withName: TLDR {
                container = 'docker://quay.io/sarahbeecroft9/tldr'
                cpus = 1
                memory = '4 GB'
            }

            withName: PALMER {
                container = 'docker://quay.io/ymostovoy/lr-palmer'
                cpus = 2
                memory = '4 GB'
            }

            withName: XTEA {
                container = 'docker://quay.io/ymostovoy/lr-xtea'
                cpus = 2
                memory = '4 GB'
            }

            withName: TREMOLO {
                container = 'https://github.com/DrosophilaGenomeEvolution/TrEMOLO/releases/download/v2.5.4b/TrEMOLO.simg'
                containerOptions = '-B /scratch/prj/ppn_als_longread/HERV_detection/resources/TrEMOLO:/TrEMOLO'
                cpus = 8
                memory = '8 GB'
            }

            withName: BAM2FASTQ {
                container = 'https://depot.galaxyproject.org/singularity/samtools:1.9--h91753b0_8'
                cpus = 2
                memory = '8 GB'
            }

            withName: PREP_TREMOLO {
                cpus = 1
                memory = '1 GB'
            }
        }
    }

    create {
        process {
            queue = "nd_bioinformatics_cpu"
            errorStrategy = 'retry'
            maxRetries = 3

            withName: STELLER {
                container = 'docker://kristinebilgrav/steller'
                cpus = 2
                memory = { 4.GB * task.attempt }
                time = { 30.min * task.attempt }
            }

            withName: TLDR {
                container = 'docker://quay.io/sarahbeecroft9/tldr'
                cpus = 8
                memory = { 64.GB }
                time = { 96.h * task.attempt }
            }

            withName: PALMER_ALU {
                container = 'docker://quay.io/ymostovoy/lr-palmer'
                cpus = 2
                memory = { 150.GB }
                time = { 72.h }
            }

            withName: PALMER_L1 {
                container = 'docker://quay.io/ymostovoy/lr-palmer'
                cpus = 2
                memory = { 16.GB * task.attempt }
                time = { 96.h * task.attempt }
            }

            withName: PALMER_SVA {
                container = 'docker://quay.io/ymostovoy/lr-palmer'
                cpus = 2
                memory = { 8.GB * task.attempt }
                time = { 96.h * task.attempt}
            }

            withName: PALMER_HERV {
                container = 'docker://quay.io/ymostovoy/lr-palmer'
                cpus = 8
                memory = { 8.GB * task.attempt }
                time = { 24.h * task.attempt}
            }

            withName: XTEA {
                container = 'docker://quay.io/ymostovoy/lr-xtea'
                cpus = 2
                memory = { 16.GB * task.attempt }
                time = { 12.h * task.attempt}
            }

            withName: TREMOLO {
                container = 'https://github.com/DrosophilaGenomeEvolution/TrEMOLO/releases/download/v2.5.4b/TrEMOLO.simg'
                containerOptions = '-B /scratch/prj/ppn_als_longread/HERV_detection/resources/TrEMOLO:/TrEMOLO'
                cpus = 8
                memory = { 32.GB * task.attempt }
                time = { 18.h * task.attempt}
            }

            withName: BAM2FASTQ {
                container = 'https://depot.galaxyproject.org/singularity/samtools:1.9--h91753b0_8'
                cpus = 2
                memory = { 8.GB }
                time = { 30.min * task.attempt}
            }

            withName: PREP_TREMOLO {
                cpus = 1
                memory = '1 GB'
            }
        }
    }
}

docker.enabled = false

singularity{
    enabled = true
    autoMounts = true
    cacheDir = '/scratch/prj/ppn_als_longread/HERV_detection/singularity_cache/'
}

conda {
    enabled = true
}

executor {
    name = "slurm"
    queueSize = 30
}