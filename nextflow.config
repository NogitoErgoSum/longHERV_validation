//Parameters
params {
    // Accessory files
    ref_fasta = '/scratch/prj/ppn_als_longread/HERV_detection/resources/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna'
    te_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_SVA_HERV_ALU_L1.fasta'
    l1_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_L1.fasta'
    herv_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_HERV.fasta'
    sva_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_SVA.fasta'
    alu_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_ALU.fasta'
    tremolo_snk = "/scratch/prj/ppn_als_longread/HERV_detection/resources/TrEMOLO/TrEMOLO/run.snk"
    tremolo_config = "/scratch/prj/ppn_als_longread/HERV_detection/resources/TrEMOLO/TrEMOLO/config.yaml"
    locate_resource_dir = "/scratch/prj/ppn_als_longread/HERV_detection/resources/LOCATE/GRCh38"
    
    // Directories
    outdir = '/scratch/prj/ppn_als_longread/HERV_detection/longHERV_validation/output/'
}

profiles {
    // Small, self-contained run for CI (GitHub Actions) or a laptop:
    // local executor + Docker, all inputs from tests/data/ in this repo.
    //   nextflow run longHERV_validation.nf -profile debug --mode steller
    // Not supported here: tremolo (Singularity-only image),
    // locate (needs the GRCh38 resource dir), telr (conda env needs a patch).
    debug {
        params.ref_fasta      = "${projectDir}/tests/data/HG38_chr22.fa"
        params.te_ref         = "${projectDir}/tests/data/TEsequences_SVA_HERV_ALU_L1.fasta"
        params.alu_ref        = "${projectDir}/tests/data/TEsequences_ALU.fasta"
        params.l1_ref         = "${projectDir}/tests/data/TEsequences_L1.fasta"
        params.herv_ref       = "${projectDir}/tests/data/TEsequences_HERV.fasta"
        params.sva_ref        = "${projectDir}/tests/data/TEsequences_SVA.fasta"
        params.tremolo_config = "${projectDir}/resources/tremolo/config.yaml"
        params.tremolo_snk    = "${projectDir}/resources/tremolo/run.snk"
        params.samplefile     = "${projectDir}/tests/data/samples_test.txt"
        params.outdir         = 'results_debug'

        executor.name         = 'local'
        docker.enabled        = true
        docker.runOptions     = '-u $(id -u):$(id -g)'
        singularity.enabled   = false
        conda.enabled         = false

        process {
            errorStrategy  = 'terminate'
            maxRetries     = 0
            // a free GitHub runner has 4 CPUs and 16 GB RAM
            resourceLimits = [ cpus: 4, memory: 14.GB, time: 1.h ]
            cpus           = 1
            memory         = '4 GB'

            withName: STELLER {
                container = 'kristinebilgrav/steller'
            }
            withName: TLDR {
                container = 'quay.io/sarahbeecroft9/tldr'
            }
            withName: 'PALMER.*' {
                container = 'quay.io/ymostovoy/lr-palmer'
                cpus      = 2
            }
            withName: XTEA {
                container = 'quay.io/ymostovoy/lr-xtea'
                cpus      = 2
            }
            withName: BAM2FASTQ {
                container = 'quay.io/biocontainers/samtools:1.9--h91753b0_8'
                cpus      = 2
            }
        }
    }

    test {
        params.te_ref = 'tests/data/TEsequences_SVA_HERV_ALU_L1.fasta'
        params.ref_fasta = 'tests/data/sTELLeR_supplementary/refgenome/HG38_chr22.fa'
        params.samplefile = 'tests/data/samples_test.txt'
        
        report {
            enabled = true
            overwrite = true
        }
        trace {
            enabled = true
        }

        process {
            queue = "celgene_cpu"
            errorStrategy = 'terminate'
            maxRetries = 0
            time = 10.min

            withName: STELLER {
                container = 'docker://kristinebilgrav/steller'
                cpus = 1
                memory = '4 GB'
            }

            withName: TLDR {
                container = 'docker://quay.io/sarahbeecroft9/tldr'
                cpus = 1
                memory = '4 GB'
            }

            withName: TELR {
                cpus    = 1
                memory  = '4 GB'
            }

            withName: PALMER {
                container = 'docker://quay.io/ymostovoy/lr-palmer'
                cpus = 2
                memory = '4 GB'
            }

            withName: XTEA {
                container = 'docker://quay.io/ymostovoy/lr-xtea'
                cpus = 2
                memory = '4 GB'
            }

            withName: TREMOLO {
                container = 'https://github.com/DrosophilaGenomeEvolution/TrEMOLO/releases/download/v2.5.4b/TrEMOLO.simg'
                containerOptions = '-B /scratch/prj/ppn_als_longread/HERV_detection/resources/TrEMOLO:/TrEMOLO'
                cpus = 8
                memory = '8 GB'
            }

            withName: BAM2FASTQ {
                container = 'https://depot.galaxyproject.org/singularity/samtools:1.9--h91753b0_8'
                cpus = 2
                memory = '8 GB'
            }

            withName: PREP_TREMOLO {
                cpus = 1
                memory = '1 GB'
            }

            withName: LOCATE {
                container = 'docker://huzr14830/locate'
                containerOptions = '-B /scratch/prj/ppn_als_longread/HERV_detection/resources/LOCATE/GRCh38:/GRCh38'
                cpus = 2
                memory = '4 GB'
            }
        }
    }

    cluster {
        process {
            queue = "celgene_cpu"
            errorStrategy = 'retry'
            maxRetries = 3

            withName: STELLER {
                container = 'docker://kristinebilgrav/steller'
                cpus = 2
                memory = { 4.GB * task.attempt }
                time = { 30.min * task.attempt }
            }

            withName: TLDR {
                container = 'docker://quay.io/sarahbeecroft9/tldr'
                cpus = 8
                memory = { 64.GB }
                time = { 96.h * task.attempt }
            }

            withName: TELR {
                cpus = 8
                memory = '16 GB'
                time = { 4.h }
            }

            withName: PALMER_ALU {
                container = 'docker://quay.io/ymostovoy/lr-palmer'
                cpus = 2
                memory = { 150.GB }
                time = { 72.h }
            }

            withName: PALMER_L1 {
                container = 'docker://quay.io/ymostovoy/lr-palmer'
                cpus = 2
                memory = { 16.GB * task.attempt }
                time = { 96.h * task.attempt }
            }

            withName: PALMER_SVA {
                container = 'docker://quay.io/ymostovoy/lr-palmer'
                cpus = 2
                memory = { 8.GB * task.attempt }
                time = { 96.h * task.attempt}
            }

            withName: PALMER_HERV {
                container = 'docker://quay.io/ymostovoy/lr-palmer'
                cpus = 8
                memory = { 8.GB * task.attempt }
                time = { 24.h * task.attempt}
            }

            withName: XTEA {
                container = 'docker://quay.io/ymostovoy/lr-xtea'
                cpus = 2
                memory = { 16.GB * task.attempt }
                time = { 12.h * task.attempt}
            }

            withName: TREMOLO {
                container = 'https://github.com/DrosophilaGenomeEvolution/TrEMOLO/releases/download/v2.5.4b/TrEMOLO.simg'
                containerOptions = '-B /scratch/prj/ppn_als_longread/HERV_detection/resources/TrEMOLO:/TrEMOLO'
                cpus = 8
                memory = { 32.GB * task.attempt }
                time = { 18.h * task.attempt}
            }

            withName: BAM2FASTQ {
                container = 'https://depot.galaxyproject.org/singularity/samtools:1.9--h91753b0_8'
                cpus = 2
                memory = { 8.GB }
                time = { 30.min * task.attempt}
            }

            withName: PREP_TREMOLO {
                cpus = 1
                memory = '1 GB'
            }

            withName: LOCATE {
                container = 'docker://huzr14830/locate'
                containerOptions = '-B /scratch/prj/ppn_als_longread/HERV_detection/resources/LOCATE/GRCh38:/GRCh38'
                cpus = 8
                memory = { 64.GB * task.attempt }
                time = { 4.h * task.attempt}
            }
        }
    }
}

docker.enabled = false

singularity{
    enabled = true
    autoMounts = true
    cacheDir = '/scratch/prj/ppn_als_longread/HERV_detection/singularity_cache/'
}

conda {
    enabled     = true
    useMamba = true
    cacheDir    = '/scratch/prj/ppn_als_longread/HERV_detection/conda_cache/'
    createTimeout = '1 h'
}

executor {
    name = "slurm"
    queueSize = 30
}
