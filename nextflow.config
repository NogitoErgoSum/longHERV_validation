//Parameters
params {
    // Accessory files
    ref_fasta = '/scratch/prj/ppn_als_longread/HERV_detection/resources/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna'
    te_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_SVA_HERV_ALU_L1.fasta'
    l1_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_L1.fasta'
    herv_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_HERV.fasta'
    sva_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_SVA.fasta'
    alu_ref = '/scratch/prj/ppn_als_longread/HERV_detection/resources/TEsequences_ALU.fasta'
    tremolo_snk = "/scratch/prj/ppn_als_longread/HERV_detection/resources/TrEMOLO/TrEMOLO/run.snk"
    tremolo_config = "/scratch/prj/ppn_als_longread/HERV_detection/resources/TrEMOLO/TrEMOLO/config.yaml"
    locate_resource_dir = "/scratch/prj/ppn_als_longread/HERV_detection/resources/LOCATE/GRCh38"
    
    // Directories
    outdir = 'output/'
}

profiles {
    test { includeConfig 'conf/test.config' }

    create { queue = "celgene_cpu" }

    cluster {
        process {
            errorStrategy = 'retry'
            maxRetries = 3

            withName: STELLER {
                cpus = 2
                memory = { 4.GB * task.attempt }
                time = { 30.min * task.attempt }
            }

            withName: TLDR {
                cpus = 8
                memory = { 64.GB }
                time = { 96.h * task.attempt }
            }

            withName: TELR {
                cpus = 8
                memory = '16 GB'
                time = { 4.h }
            }

            withName: PALMER_ALU {
                cpus = 2
                memory = { 150.GB }
                time = { 72.h }
            }

            withName: PALMER_L1 {
                cpus = 2
                memory = { 16.GB * task.attempt }
                time = { 96.h * task.attempt }
            }

            withName: PALMER_SVA {
                cpus = 2
                memory = { 8.GB * task.attempt }
                time = { 96.h * task.attempt}
            }

            withName: PALMER_HERV {
                cpus = 8
                memory = { 8.GB * task.attempt }
                time = { 24.h * task.attempt}
            }

            withName: XTEA {
                cpus = 2
                memory = { 16.GB * task.attempt }
                time = { 12.h * task.attempt}
            }

            withName: TREMOLO {
                containerOptions = '-B /scratch/prj/ppn_als_longread/HERV_detection/resources/TrEMOLO:/TrEMOLO'
                cpus = 8
                memory = { 32.GB * task.attempt }
                time = { 18.h * task.attempt}
            }

            withName: BAM2FASTQ {
                cpus = 2
                memory = { 8.GB }
                time = { 30.min * task.attempt}
            }

            withName: PREP_TREMOLO {
                cpus = 1
                memory = '1 GB'
            }

            withName: LOCATE {
                containerOptions = '-B /scratch/prj/ppn_als_longread/HERV_detection/resources/LOCATE/GRCh38:/GRCh38'
                cpus = 8
                memory = { 64.GB * task.attempt }
                time = { 4.h * task.attempt}
            }
        }
    }
}

docker.enabled = false

singularity{
    enabled = true
    autoMounts = true
    cacheDir = '/scratch/prj/ppn_als_longread/HERV_detection/singularity_cache/'
}

conda {
    enabled     = true
    useMamba = true
    cacheDir    = '/scratch/prj/ppn_als_longread/HERV_detection/conda_cache/'
    createTimeout = '1 h'
}

executor {
    name = "slurm"
    queueSize = 30
}
